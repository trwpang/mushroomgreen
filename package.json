{
  "name": "mushroomgreen",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Family history archive map of Mushroom Green, 1865.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:clusters": "node src/scripts/build-clusters.ts",
    "sprites:pipeline": "node scripts/sprite-pipeline.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "forge:model": "blender --background --python-exit-code 1 --python scripts/forge/build_forge.py && node scripts/forge/optimize.mjs",
    "forge:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck src/scripts/forge/scene.ts",
    "village:model": "blender --background --python-exit-code 1 --python scripts/village/build_cottages.py && node scripts/village/optimize.mjs",
    "village:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --allowSyntheticDefaultImports --skipLibCheck src/scripts/village/scene.ts",
    "village:layouts": "esbuild scripts/village/check-interiors.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-interiors-check.mjs && node /tmp/mushroom-interiors-check.mjs",
    "village:life": "esbuild scripts/village/check-life.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-life-check.mjs && node /tmp/mushroom-life-check.mjs",
    "prebuild": "node scripts/check-runtime-assets.mjs",
    "village:workshop": "esbuild scripts/village/check-workshop.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-workshop-check.mjs && node /tmp/mushroom-workshop-check.mjs",
    "chainmaker:model": "blender --background --python-exit-code 1 --python scripts/chainmaker/build_chainmaker.py && node scripts/chainmaker/optimize.mjs",
    "chainmaker:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck src/scripts/chainmaker/scene.ts && esbuild scripts/chainmaker/check-rig.ts --bundle --platform=node --format=esm --outfile=/tmp/chainmaker-check.mjs && node /tmp/chainmaker-check.mjs",
    "surfaces:check": "esbuild scripts/rendering/check-surfaces.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-surfaces-check.mjs && node /tmp/mushroom-surfaces-check.mjs",
    "village:outbuildings": "esbuild scripts/village/check-outbuildings.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-outbuildings-check.mjs && node /tmp/mushroom-outbuildings-check.mjs",
    "village:inhabited": "esbuild scripts/village/check-inhabited.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-inhabited-check.mjs && node /tmp/mushroom-inhabited-check.mjs",
    "village:navigation": "esbuild scripts/village/check-navigation.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-navigation-check.mjs && node /tmp/mushroom-navigation-check.mjs",
    "village:cart": "esbuild scripts/village/check-cart.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-cart-check.mjs && node /tmp/mushroom-cart-check.mjs",
    "village:props": "esbuild scripts/village/check-props.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-props-check.mjs && node /tmp/mushroom-props-check.mjs",
    "village:objects": "esbuild scripts/village/check-interior-objects.ts --bundle --platform=node --format=esm --outfile=/tmp/interior-objects-check.mjs && node /tmp/interior-objects-check.mjs",
    "village:objects:export": "esbuild scripts/village/export-interior-objects.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/mushroom-interior-export.mjs && node node_modules/.cache/mushroom-interior-export.mjs",
    "village:textures": "esbuild scripts/village/check-texture-residency.ts --bundle --platform=node --format=esm --outfile=/tmp/mushroom-texture-check.mjs && node /tmp/mushroom-texture-check.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@babylonjs/core": "^9.4.1",
    "@babylonjs/loaders": "^9.4.1",
    "astro": "^5.0.0",
    "phaser": "^3.90.0",
    "phaser4": "npm:phaser@^4.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.6.0",
    "@types/three": "^0.186.0",
    "sharp": "0.34.5"
  }
}
