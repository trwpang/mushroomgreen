{
  "name": "mushroomgreen",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Family history archive map of Mushroom Green, 1865.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:clusters": "node src/scripts/build-clusters.ts",
    "sprites:pipeline": "node scripts/sprite-pipeline.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "forge:model": "blender --background --python-exit-code 1 --python scripts/forge/build_forge.py && node scripts/forge/optimize.mjs",
    "forge:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck src/scripts/forge/scene.ts",
    "village:model": "blender --background --python-exit-code 1 --python scripts/village/build_cottages.py && node scripts/village/optimize.mjs",
    "village:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --resolveJsonModule --allowSyntheticDefaultImports --skipLibCheck src/scripts/village/scene.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@babylonjs/core": "^9.4.1",
    "@babylonjs/loaders": "^9.4.1",
    "astro": "^5.0.0",
    "phaser": "^3.90.0",
    "phaser4": "npm:phaser@^4.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.6.0",
    "@types/three": "^0.186.0",
    "sharp": "0.34.5"
  }
}
