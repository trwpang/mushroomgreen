---
import {getCollection,render} from 'astro:content';
const records=(await getCollection('households')).sort((a,b)=>a.data.number-b.data.number);
const entries=await Promise.all(records.map(async h=>({h,...await render(h)})));
const nearby=(h:typeof records[number])=>records.filter(n=>n.data.number!==h.data.number).sort((a,b)=>Math.hypot(a.data.position.lat-h.data.position.lat,(a.data.position.lon-h.data.position.lon)*.61)-Math.hypot(b.data.position.lat-h.data.position.lat,(b.data.position.lon-h.data.position.lon)*.61)).slice(0,3);
---
<aside id="house-panel" hidden aria-labelledby="house-name" tabindex="-1">
 <button id="close-house" aria-label="Close household details">×</button>
 <div class="eyebrow" id="house-number"></div><h2 id="house-name"></h2>
 <p id="house-description" class="reader-intro"></p>
 <div class="reader-actions"><button id="visit-house">View house</button><button id="enter-house">Go inside</button></div>
 <div class="workshop-links"><button id="enter-chainshop" hidden>Inside Henry’s chainshop</button><button id="visit-yard" hidden>Explore the working yard</button></div>
 <div id="house-record"></div>
 <div class="reader-pages"><button id="previous-house" aria-label="Previous household">← Previous home</button><button id="next-house" aria-label="Next household">Next home →</button></div>
</aside>
{entries.map(({h,Content})=><template data-house-record={h.data.number}>
 <div class="record-facts"><div><span class="record-value">{h.data.occupants_1861||'—'}</span><span>{h.data.occupants_1861===1?'person recorded':'people recorded'}<small>1861 census</small></span></div><div><span class="record-family">{h.data.family}</span><span>Family listing<small>Household {h.data.number}</small></span></div></div>
 {h.data.founder&&<p class="record-note">Henry Weaver’s household is the starting point of this family village study.</p>}
 <section class="reader-section"><h3>The household</h3>{h.body?.trim()?<div class="record-prose"><Content/></div>:<p>The map identifies this household as <strong>{h.data.household_name}</strong>. A written family account has not yet been added to this record.</p>}</section>
 <section class="reader-section"><h3>The place</h3><p>{h.data.estimated_position?'The family map marks this position as estimated.':'This position follows the family map.'} The building, rooms, furniture and daily-life details are interpretations.</p>{h.data.number===22&&<p>Family recollection places a small chainshop at one end of the home. The scene puts it at the roadside end; its exact historic form is uncertain.</p>}{h.data.number===5&&<p>The surviving chain workshop occupies this location in the scene. The household record remains separate from the modern landmark.</p>}</section>
 <section class="reader-section"><h3>Sources</h3><ul class="record-sources">{(h.data.sources?.length?h.data.sources:['Family household map, compiled by Mike Mushroom']).map(s=><li>{s}</li>)}</ul></section>
 <section class="reader-section"><h3>Nearby households</h3><p class="reader-small">Follow the map to another home.</p><div class="record-neighbours">{nearby(h).map(n=><button data-select-house={n.data.number}><span>{String(n.data.number).padStart(2,'0')}</span>{n.data.household_name}<b aria-hidden="true">↗</b></button>)}</div></section>
 {h.data.related_households?.length&&<section class="reader-section"><h3>Recorded family connections</h3>{h.data.related_households.map(n=><button data-select-house={n}>Household {n} →</button>)}</section>}
 <p class="record-credit">Family research and mapping by Mike Mushroom.<br/>A place remembered · Mushroom Green, 1865</p>
</template>)}
<style is:global>
#house-panel:focus{outline:none}#enter-chainshop,#visit-yard{width:100%;min-height:42px;margin:0 0 12px;padding:10px;border:1px solid #8c795644;border-radius:4px;color:#665334;background:#ece6d8;font-size:12px}

#house-panel{width:min(410px,calc(100vw - 40px));top:20px;right:20px;bottom:112px;overflow:auto;padding:32px 30px 22px;background:#f7f3e9f7;border-radius:8px;box-shadow:0 16px 70px #14251e40;scrollbar-width:thin;overscroll-behavior:contain}#house-panel h2{font:400 32px/1.06 Georgia,serif;margin:16px 20px 12px 0;letter-spacing:-.7px}#house-panel p{font-size:13px;line-height:1.65}#house-panel .reader-intro{color:#6e735e;font-size:12px;margin-bottom:20px}#house-panel #close-house{width:36px;height:36px;right:12px;top:12px}#house-panel .reader-actions{display:flex;gap:8px;margin-bottom:24px}#house-panel .reader-actions button{flex:1;min-height:43px;padding:10px;border:1px solid #53604c40;border-radius:4px;font-size:12px;margin:0}#visit-house{background:#e8e7da;color:#384b3d}#enter-house{background:#354a3c;color:#f5efdf}#enter-house:disabled{opacity:.55;cursor:default}.record-facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #77826933;border-bottom:1px solid #77826933;padding:18px 0;gap:20px}.record-facts>div{display:flex;flex-direction:column;gap:9px}.record-facts .record-value{font:36px/1 Georgia,serif}.record-facts .record-family{font:25px/1.4 Georgia,serif}.record-facts span{font-size:12px}.record-facts small{display:block;color:#7b7c6c;font-size:10px;line-height:1.7}.reader-section{margin-top:24px}.reader-section h3{font:400 19px Georgia,serif;margin:0 0 9px;color:#344839}.reader-section p{margin:0 0 10px}.record-note{padding:12px 14px;background:#e8e4d3;border-left:2px solid #98744d}.record-sources{margin:0;padding-left:18px;font-size:12px;color:#626654;line-height:1.7}.record-neighbours{display:grid;gap:5px}.record-neighbours button{display:flex;text-align:left;align-items:center;gap:10px;border:0;border-bottom:1px solid #75816725;background:none;padding:10px 0;color:#3f5445;font-size:12px;min-height:42px}.record-neighbours button span{font:19px Georgia,serif;color:#9c7b55;min-width:25px}.record-neighbours button b{margin-left:auto;font-weight:normal}.reader-small{font-size:11px!important;color:#83816f!important}.record-credit{font-size:10px!important;color:#868170!important;margin-top:24px}.reader-pages{display:flex;justify-content:space-between;border-top:1px solid #75816733;padding-top:14px;margin-top:20px}.reader-pages button{border:0;background:none;color:#6f654c;font-size:11px;padding:8px 0;min-height:38px}.record-prose h2{font-size:21px!important}.record-prose img{max-width:100%}.record-prose a{display:inline;font-size:inherit}#village-app:has(#house-panel:not([hidden])) .edition{display:none}
@media(max-width:640px){#house-panel{top:auto;bottom:0;left:0;right:0;width:100%;max-height:65dvh;padding:26px 24px 18px;border-radius:16px 16px 0 0;z-index:8}#house-panel h2{font-size:28px}.reader-actions{position:sticky;top:-26px;background:#f7f3e9;padding:8px 0;z-index:1}.record-facts{padding:14px 0}#house-panel #close-house{right:14px;top:12px}}
</style>
