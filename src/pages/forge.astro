---
const title = 'The chain shop · Mushroom Green';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An explorable study of the Mushroom Green chain shop, modelled from photographs in Blender." />
    <title>{title}</title>
  </head>
  <body>
    <main id="forge-app">
      <div id="forge-canvas" aria-label="Interactive 3D model of the Mushroom Green chain shop"></div>
      <header>
        <a class="eyebrow" href="/">MUSHROOM GREEN <span> / </span> FIELD STUDIES</a>
        <h1>The chain shop<span>.</span></h1>
        <p>Brick, iron, and the warmth of a working hearth.</p>
      </header>
      <div class="edition"><span class="dot"></span> A PLACE REMEMBERED <b>01 / FORGE</b></div>
      <div id="loading" role="status"><span class="loader"></span><span id="load-label">Opening the workshop…</span></div>
      <div class="view-switch" role="group" aria-label="Camera view">
        <button data-view="overview" aria-pressed="true">The yard</button>
        <button data-view="roof" aria-pressed="false">The roof</button>
        <button data-view="detail" aria-pressed="false">The brickwork</button>
      </div>
      <aside id="note" hidden>
        <button id="close-note" aria-label="Close field notes">×</button>
        <span class="eyebrow">FIELD NOTE / 01</span>
        <h2>A small shop.<br />A world of work.</h2>
        <p>The long brick shell, low slate roof, wooden shutters, and three chimneys follow photographs of the surviving Mushroom Green chain shop.</p>
        <p>The hearths, tools, plants, and yard form an interpretive study. This is not a measured reconstruction of the building in 1865.</p>
        <a href="https://bclm.com/plan-your-visit/trails/industrial-enthusiasts/" target="_blank" rel="noreferrer">Explore Black Country workshop history ↗</a>
        <a href="/village">Explore the whole village ↗</a>
        <a href="/forge/mushroom-green-forge.glb" download>Download the 3D model ↓</a>
      </aside>
      <footer>
        <div class="caption"><span class="line"></span><div><strong>Mushroom Green, Black Country</strong><span>A study for the 1865 village</span></div></div>
        <nav class="tools" aria-label="Scene controls">
          <button id="light" aria-pressed="false"><span aria-hidden="true">☀</span><span>Daylight</span></button>
          <span class="divider"></span>
          <button id="motion" aria-pressed="false"><span aria-hidden="true">Ⅱ</span><span>Pause</span></button>
          <span class="divider"></span>
          <button id="reset" aria-label="Reset camera"><span aria-hidden="true">↺</span></button>
          <button id="notes" aria-expanded="false" aria-controls="note" aria-label="Show field notes"><span aria-hidden="true">i</span></button>
        </nav>
        <div class="instructions">DRAG TO EXPLORE <span>·</span> SCROLL TO MOVE CLOSER</div>
      </footer>
      <div id="render-status" class="sr-only" role="status"></div>
    </main>
    <script>import '../scripts/forge/scene';</script>
  </body>
</html>
<style is:global>
  *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#c5c7b6;color:#29352d;font-family:Arial,Helvetica,sans-serif}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit}button:focus-visible,a:focus-visible{outline:2px solid #6a492f;outline-offset:5px}#forge-app,#forge-canvas{width:100%;height:100%;position:absolute;inset:0}#forge-canvas canvas{display:block;touch-action:none;width:100%;height:100%}header{position:absolute;top:40px;left:44px;pointer-events:none}header a{pointer-events:auto;text-decoration:none;color:inherit}.eyebrow{font-size:10px;letter-spacing:2.4px;font-weight:600}.eyebrow span{padding:0 12px;opacity:.4}h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(34px,4.3vw,62px);font-weight:400;letter-spacing:-2.5px;margin:15px 0 9px}h1 span{color:#9b5935}header p{font-size:12px;letter-spacing:.25px;color:#586052;margin:0}.edition{position:absolute;top:45px;right:44px;font-size:9px;letter-spacing:1.7px;display:flex;align-items:center;gap:9px}.edition b{display:block;margin-left:22px;font-weight:400;color:#697161}.dot{width:5px;height:5px;background:#9b5935;border-radius:50%}.view-switch{position:absolute;top:182px;left:44px;display:flex;gap:4px;border-bottom:1px solid #34433128}.view-switch button{border:0;background:none;padding:10px 12px 11px;color:#64705f;font-size:11px;cursor:pointer;position:relative}.view-switch button:first-child{padding-left:0}.view-switch button[aria-pressed=true]{color:#273b2a}.view-switch button[aria-pressed=true]:after{content:'';height:2px;background:#966341;position:absolute;bottom:-1px;left:0;right:0}footer{position:absolute;inset:auto 0 0;height:135px;pointer-events:none;background:linear-gradient(transparent,#c5c7b675)}.caption{position:absolute;bottom:43px;left:44px;display:flex;align-items:center;gap:14px}.caption .line{width:30px;height:1px;background:#72806a}.caption strong{font-family:Georgia,serif;font-weight:400;font-size:15px}.caption div>span{display:block;font-size:10px;color:#65705e;margin-top:5px}.tools{position:absolute;bottom:38px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:3px;padding:7px 10px;background:#f8f7eeec;border:1px solid #ffffff90;border-radius:9px;box-shadow:0 7px 32px #26312616;pointer-events:auto;white-space:nowrap}.tools button{display:flex;gap:9px;align-items:center;justify-content:center;cursor:pointer;border:0;background:transparent;color:#3f4d3e;padding:10px;font-size:11px;border-radius:5px;min-height:36px}.tools button>span:first-child{font-size:18px;line-height:16px}.tools button:hover{background:#e8eadd}.tools button[aria-pressed=true]{color:#8b512d;background:#eee4d7}.divider{height:17px;width:1px;background:#293d261c;margin:0 2px}.instructions{position:absolute;right:44px;bottom:53px;font-size:8px;letter-spacing:1.1px;color:#6e7867}.instructions span{padding:0 7px}#loading{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:12px;font-size:12px;background:#f8f7eeed;padding:20px 25px;border-radius:8px;transition:opacity .4s}#loading[hidden]{display:none}.loader{width:17px;height:17px;border:1px solid #98a18d;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#note{position:absolute;right:35px;bottom:110px;width:335px;padding:31px;background:#f6f3e9ed;backdrop-filter:blur(15px);border:1px solid #ffffff9c;box-shadow:0 12px 48px #28332015;border-radius:6px}#note h2{font-family:Georgia,serif;font-weight:400;font-size:29px;line-height:1.13;letter-spacing:-.7px;margin:20px 0}#note p{font-size:12px;line-height:1.65;color:#626858}#note a{font-size:10px;line-height:1.5;color:#755437;display:block;margin-top:16px}#close-note{position:absolute;top:10px;right:12px;background:none;border:0;font-size:23px;color:#69715e;cursor:pointer}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  @media(max-width:1250px){.instructions{bottom:17px;left:0;right:0;text-align:center}.caption{bottom:90px;font-size:12px}.tools{bottom:37px}}
  @media(max-width:640px){header{top:26px;left:24px}h1{font-size:40px;letter-spacing:-1.6px}header p{font-size:10px}.eyebrow{font-size:8px;letter-spacing:1.8px}.edition{top:30px;right:24px}.edition>b,.edition .dot{display:none}.edition{font-size:0}.view-switch{top:155px;left:24px}.caption{left:24px;bottom:101px}.caption strong{font-size:13px}.tools{padding:5px;bottom:38px;max-width:calc(100% - 30px)}.tools button{padding:9px 8px;font-size:10px;gap:6px}.instructions{font-size:7px}#note{width:calc(100% - 40px);right:20px;bottom:142px;max-height:calc(100% - 180px);overflow:auto}#loading{width:max-content;max-width:90%}}
  @media(prefers-reduced-motion:reduce){.loader{animation:none}}
  #forge-app[data-view]:not([data-view=overview]) header{background:#e7e8dddb;padding:18px 22px;border-radius:6px;top:22px;left:22px;backdrop-filter:blur(10px)}
  #forge-app[data-view]:not([data-view=overview]) h1{font-size:32px;letter-spacing:-1px;margin-bottom:0}
  #forge-app[data-view]:not([data-view=overview]) header p{display:none}
  #forge-app[data-view]:not([data-view=overview]) .view-switch{top:130px;background:#e7e8dde0;padding:0 10px;border-radius:4px}
  #forge-app[data-light=dusk] .edition,#forge-app[data-light=dusk] .caption,#forge-app[data-light=dusk] .caption div>span,#forge-app[data-light=dusk] .instructions{color:#edece0}
  #forge-app[data-view=overview][data-light=dusk] header{color:#edece0}
  #forge-app[data-view=overview][data-light=dusk] header p,#forge-app[data-view=overview][data-light=dusk] .view-switch button{color:#e1e4d4}
</style>
