---
import {interiorCatalogue} from '../scripts/village/interior-catalogue';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Objects of home · Mushroom Green</title></head><body>
<main id="object-stage" aria-label="Interior object study"></main>
<header><a href="/village?view=henry&house=22&room=1">← Henry’s home</a><p>MUSHROOM GREEN / 1865</p><h1>Objects of home.</h1><p>100 original models · Drag to turn · Scroll to look closer</p></header>
<aside><label for="object-choice">Choose an object</label><select id="object-choice">{interiorCatalogue.map(([id,name],i)=><option value={id}>{String(i+1).padStart(2,'0')}. {name}</option>)}</select><div><button id="object-prev">← Previous</button><button id="object-next">Next →</button></div><p id="object-caption" role="status">Preparing the study…</p><p><a href="/interior-objects/catalogue.glb" download>Download all 100 models for Blender</a></p><p class="note">Fittings inspired by museum references. Household ownership and exact 1865 forms are interpreted.</p></aside>
<script src="../scripts/village/interior-object-study.ts"></script>
<style is:global>html,body{margin:0;background:#d9d5c6;color:#303a2c;font-family:Georgia,serif}#object-stage{position:fixed;inset:0}canvas{display:block}header{position:fixed;top:26px;left:30px;pointer-events:none;max-width:420px}header a{pointer-events:auto;color:inherit;font:13px system-ui}header p{font:12px system-ui}h1{font-weight:normal;font-size:42px;margin:12px 0}aside{position:fixed;right:24px;bottom:24px;background:#f1efe3ed;padding:20px;border-radius:8px;max-width:340px;font:13px system-ui}label{display:block;margin-bottom:9px}select{font:14px system-ui;width:100%;padding:9px;border:1px solid #b3b6a7;background:#f9f7ec;color:inherit}aside div{display:flex;gap:8px;margin-top:10px}button{padding:9px 14px;border:1px solid #a6ad99;background:#394b3b;color:#fffdf1;border-radius:4px;cursor:pointer}#object-caption{line-height:1.5}.note{font-size:11px;line-height:1.5;color:#666f60}@media(max-width:600px){header{top:14px;left:18px}h1{font-size:29px}aside{right:12px;left:12px;bottom:12px;max-width:none;padding:12px}}</style>
</body></html>
