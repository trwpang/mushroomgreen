---
import {propNames} from '../scripts/village/working-props';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Working objects · Mushroom Green</title></head><body>
<main id="prop-stage" aria-label="Village prop study"></main>
<header><a href="/village?view=forge">← Back to the village</a><h1>Working objects.</h1><p>Ten small details of village life · Drag to turn · Scroll to move closer</p></header>
<nav aria-label="Choose an object"><button data-prop="all" aria-pressed="true">All ten</button>{Object.entries(propNames).map(([id,name])=><button data-prop={id} aria-pressed="false">{name}</button>)}</nav><p id="prop-caption" role="status">Loading the timber materials…</p>
<script src="../scripts/village/props-study.ts"></script>
<style is:global>html,body{margin:0;background:#d8d7c9;color:#303d31;font-family:Georgia,serif}#prop-stage{position:fixed;inset:0}canvas{display:block}header{position:fixed;top:24px;left:32px;pointer-events:none}header a{pointer-events:auto;color:inherit;font:13px system-ui}h1{font-size:38px;margin:12px 0 5px}header p{font:13px system-ui;margin:0}nav{position:fixed;bottom:45px;left:20px;right:20px;display:flex;justify-content:center;gap:5px;flex-wrap:wrap}button{border:1px solid #b5b6a7;background:#eeede3ed;color:#384b3c;border-radius:4px;padding:9px 11px;font:12px system-ui;cursor:pointer}button[aria-pressed=true]{background:#384b3c;color:#faf8eb}#prop-caption{position:fixed;bottom:6px;width:100%;text-align:center;font:12px system-ui}@media(max-width:600px){header{top:15px;left:18px}h1{font-size:27px}nav{bottom:42px}button{padding:7px;font-size:11px}}</style>
</body></html>
